{
  "name": "web3search-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Web3search API - Cloudflare Workers backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cloudflare-workers",
    "web3",
    "crypto",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "convex": "^1.31.4",
    "dotenv": "^17.2.3",
    "hono": "^4.10.4",
    "stripe": "^20.1.2",
    "toucan-js": "^4.1.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.17",
    "wrangler": "^4.53.0"
  }
}

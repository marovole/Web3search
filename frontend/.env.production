# 生产环境配置
VITE_ENVIRONMENT=production
VITE_API_BASE_URL=https://api.lulaai.xyz
VITE_USE_MOCK_API=false

# Sentry Error Monitoring (已禁用 - DSN 未配置)
# 如需启用：设置 VITE_ENABLE_SENTRY=true 并配置有效的 DSN
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=

# Google Analytics (已启用)
# Measurement ID 来自 GA4 Property: Web3Search Production
VITE_ENABLE_ANALYTICS=true
VITE_GA_MEASUREMENT_ID=G-M0DW9G90FT

VITE_ENABLE_EXPERIMENTAL_FEATURES=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_DEBUG_MODE=false

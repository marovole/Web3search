# ==========================================
# Web3Search Frontend Environment Variables
# ==========================================

# Application Environment
# Options: development, staging, production
VITE_ENVIRONMENT=production

# API Configuration
# 设置为true使用Mock数据（开发前端时无需后端）
# 设置为false连接真实后端API
VITE_USE_MOCK_API=false

# API Base URL
# 生产环境（Cloudflare Workers）：https://api.lulaai.xyz
# 本地开发：http://localhost:8787
VITE_API_BASE_URL=https://api.lulaai.xyz

# Performance and Monitoring
# Enable Sentry error monitoring in production
VITE_ENABLE_SENTRY=true

# Application Settings
# Default chat mode: quick or deep
VITE_DEFAULT_CHAT_MODE=quick

# UI Settings
# Enable debug mode in development
VITE_DEBUG_MODE=false

# Feature Flags
# Enable experimental features
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Analytics and Tracking
# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Supabase Configuration (Required for Auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

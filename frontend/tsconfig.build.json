{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/__tests__/**",
    "src/__tests__/**/*",
    "tests/**",
    "src/setupTests.ts",
    "src/mocks/**",
    "src/**/*.mock.ts",
    "src/**/*.mock.tsx"
  ]
}

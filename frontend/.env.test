# Test Environment Configuration
NODE_ENV=test

# API URLs
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# Test Settings
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_TEST_MODE=true
VITE_DISABLE_ANALYTICS=true
VITE_DISABLE_SENTRY=true

# Coverage Settings
VITE_COLLECT_COVERAGE=true

# Browser Settings
VITE_HEADLESS_MODE=true

# Database (for E2E tests)
VITE_TEST_DB_URL=postgresql://test:test@localhost:5432/web3search_test

# Authentication (for tests)
VITE_TEST_JWT_SECRET=test-jwt-secret
VITE_TEST_API_KEY=test-api-key

# Feature Flags (for testing)
VITE_ENABLE_BETA_FEATURES=true
VITE_ENABLE_DEBUG_MODE=true

# Performance Settings
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_BUNDLE_ANALYZER=false

# External Services (mocked in tests)
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
VITE_VERCEL_ANALYTICS_ID=

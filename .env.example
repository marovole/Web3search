# ================================
# Convex Configuration
# ================================
CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOY_KEY=your-deploy-key

# ================================
# OpenRouter API
# ================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ================================
# Search API Keys
# ================================
BRAVE_SEARCH_API_KEY=your-brave-key
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEY=your-serper-key

# ================================
# Data Source API Keys
# ================================

# CoinGecko API (免费 50次/分钟)
COINGECKO_API_KEY=your-coingecko-key-here

# Etherscan API (免费 5次/秒)
ETHERSCAN_API_KEY=your-etherscan-key-here

# BSCScan API
BSCSCAN_API_KEY=your-bscscan-key-here

# Twitter API v2 (免费 500K条/月)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token-here

# Reddit API (免费 60次/分钟)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=Web3Search/1.0

# CryptoPanic API (免费 25次/日)
CRYPTOPANIC_API_KEY=your-cryptopanic-key-here

# ================================
# Application Configuration
# ================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=Web3 Search API
API_VERSION=2.0.0

# CORS Origins (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_QUICK_CHAT=10/minute
RATE_LIMIT_DEEP_RESEARCH=3/hour

# ================================
# Cache TTL (seconds)
# ================================
CACHE_TTL_PRICE=60
CACHE_TTL_PROJECT=3600
CACHE_TTL_REPORT=86400

# ================================
# External Services (Optional)
# ================================

# Sentry Error Tracking
SENTRY_DSN=

# Stripe (Subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VAPID (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ================================
# Supabase Configuration
# ================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ================================
# OpenRouter API
# ================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web3search
REDIS_URL=redis://localhost:6379/0

# ================================
# Data Source API Keys
# ================================

# CoinGecko API (免费 50次/分钟)
COINGECKO_API_KEY=your-coingecko-key-here

# Etherscan API (免费 5次/秒)
ETHERSCAN_API_KEY=your-etherscan-key-here

# BSCScan API
BSCSCAN_API_KEY=your-bscscan-key-here

# Twitter API v2 (免费 500K条/月)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token-here

# Reddit API (免费 60次/分钟)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=Web3Search/1.0

# CryptoPanic API (免费 25次/日)
CRYPTOPANIC_API_KEY=your-cryptopanic-key-here

# ================================
# Application Configuration
# ================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=Web3 Search API
API_VERSION=1.0.0

# CORS Origins (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_QUICK_CHAT=10/minute
RATE_LIMIT_DEEP_RESEARCH=3/hour

# ================================
# Celery Configuration
# ================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ================================
# Cache TTL (seconds)
# ================================
CACHE_TTL_PRICE=60
CACHE_TTL_PROJECT=3600
CACHE_TTL_REPORT=86400

# ================================
# External Services (Optional)
# ================================

# Sentry Error Tracking
SENTRY_DSN=

# Railway/Vercel Deployment
RAILWAY_ENVIRONMENT=
VERCEL_ENV=

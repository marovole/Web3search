# Locust Load Testing Dockerfile
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制负载测试文件
COPY locustfile.py .
COPY advanced_user_behavior.py .
COPY load_test_config.py .
COPY prepare_load_test_data.py .

# 创建必要的目录
RUN mkdir -p reports logs data

# 设置环境变量
ENV PYTHONPATH=/app
ENV LOCUST_HEADLESS=false
ENV LOCUST_WEB_PORT=8089

# 暴露端口
EXPOSE 8089

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8089/ || exit 1

# 启动命令
CMD ["locust", "-f", "locustfile.py", "--host=http://localhost:8000"]

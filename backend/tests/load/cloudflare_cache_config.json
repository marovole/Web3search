{
  "zone_settings": {
    "cache_level": "simplified",
    "browser_cache_ttl": 31536000,
    "edge_cache_ttl": 2592000,
    "cache_everything": true,
    "always_online": true
  },
  "page_rules": [
    {
      "targets": [
        {
          "target": "url",
          "constraint": {
            "operator": "matches",
            "value": "*/api/*"
          }
        }
      ],
      "actions": [
        {
          "id": "cache_level",
          "value": "cache_everything"
        },
        {
          "id": "edge_cache_ttl",
          "value": 300
        },
        {
          "id": "browser_cache_ttl",
          "value": 300
        }
      ]
    }
  ],
  "transform_rules": []
}
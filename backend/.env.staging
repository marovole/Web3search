# 预发布环境配置
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# 预发布数据库
DATABASE_URL=postgresql://user:password@staging-db-host:5432/web3search
DATABASE_ECHO=false
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=30

# 预发布Redis
REDIS_URL=redis://staging-redis-host:6379/0

# 预发布环境CORS
CORS_ORIGINS=https://staging.web3search.app

# API Keys（必填）
OPENROUTER_API_KEY=your_staging_api_key_here

# Sentry（预发布环境启用）
SENTRY_DSN=your_sentry_dsn_here

# 预发布缓存时间
CACHE_TTL_PRICE=60
CACHE_TTL_PROJECT=1800
CACHE_TTL_REPORT=43200

# Web3 Search API 配置示例
# 复制此文件为 .env（通用）、.env.dev（开发）、.env.staging（预发布）或 .env.prod（生产）

# ================================
# 基础配置
# ================================
# 运行环境: development, staging, production
ENVIRONMENT=development

# 调试模式（生产环境应为false）
DEBUG=true

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ================================
# API配置
# ================================
API_V1_PREFIX=/api/v1
API_TITLE=Web3 Search API
API_VERSION=1.0.0

# CORS配置（逗号分隔的允许域名）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://web3search.vercel.app

# ================================
# 数据库配置
# ================================
# PostgreSQL连接字符串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web3search

# 连接池配置
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50
DATABASE_POOL_MAX_QUERIES=50000
DATABASE_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=300.0
DATABASE_POOL_TIMEOUT=10.0
DATABASE_COMMAND_TIMEOUT=60.0
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE=3600

# Redis配置
REDIS_URL=redis://localhost:6379/0

# ================================
# OpenRouter API（必填）
# ================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ================================
# 数据源API（可选）
# ================================
# CoinGecko
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Etherscan
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# BSCScan
BSCSCAN_API_KEY=
BSCSCAN_BASE_URL=https://api.bscscan.com/api

# Twitter
TWITTER_BEARER_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Web3Search/1.0

# CryptoPanic
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1

# ================================
# 速率限制配置
# ================================
RATE_LIMIT_QUICK_CHAT=10/minute
RATE_LIMIT_DEEP_RESEARCH=3/hour

# ================================
# Celery配置
# ================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ================================
# 缓存TTL配置（秒）
# ================================
CACHE_TTL_PRICE=60
CACHE_TTL_PROJECT=3600
CACHE_TTL_REPORT=86400

# ================================
# 外部服务（可选）
# ================================
# Sentry错误追踪
SENTRY_DSN=

# Railway环境
RAILWAY_ENVIRONMENT=

# Vercel环境
VERCEL_ENV=

# Loki日志聚合服务
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=

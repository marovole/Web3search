# ================================
# 生产环境配置示例
# 用于Railway部署
# ================================

# 基础配置
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API配置
API_V1_PREFIX=/api/v1
API_TITLE=Web3 Search API
API_VERSION=1.0.0

# CORS配置（生产域名）
CORS_ORIGINS=https://your-frontend.vercel.app

# 数据库配置（Railway会自动注入）
# DATABASE_URL=postgresql://user:password@host:port/dbname
# REDIS_URL=redis://host:port/0

# OpenRouter API（必需）
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 数据源API（可选）
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

BSCSCAN_API_KEY=
BSCSCAN_BASE_URL=https://api.bscscan.com/api

TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Web3Search/1.0

CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1

# 速率限制配置
RATE_LIMIT_QUICK_CHAT=10/minute
RATE_LIMIT_DEEP_RESEARCH=3/hour

# Celery配置（Railway会自动注入REDIS_URL）
# CELERY_BROKER_URL=${REDIS_URL}/1
# CELERY_RESULT_BACKEND=${REDIS_URL}/1

# 缓存TTL配置（秒）
CACHE_TTL_PRICE=60
CACHE_TTL_PROJECT=3600
CACHE_TTL_REPORT=86400

# 监控（可选）
SENTRY_DSN=

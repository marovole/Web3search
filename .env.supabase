# Supabase 连接配置
# ⚠️ 安全警告：此文件已被清理，所有敏感信息已移除
# 
# 为了安全，请按以下步骤重新配置：
#
# 1. 访问 https://supabase.com/dashboard 获取你的项目信息
# 2. 设置以下环境变量（不要提交到版本控制）：
#
#    export SUPABASE_PROJECT_ID="your-project-id"
#    export SUPABASE_URL="https://your-project-id.supabase.co"
#    export SUPABASE_DB_PASSWORD="your-secure-password"
#    export SUPABASE_DATABASE_URL="postgresql://postgres.your-project-id:your-password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"
#    export SUPABASE_ANON_KEY="your-anon-key"
#    export SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
#
# 3. 对于 Cloudflare Workers，使用 wrangler secret put：
#
#    wrangler secret put SUPABASE_URL
#    wrangler secret put SUPABASE_ANON_KEY
#    wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#
# 4. 立即轮换所有之前暴露的密钥！
#
# 安全提醒：
# - 永远不要将敏感信息提交到版本控制系统
# - 定期轮换API密钥和密码
# - 使用强密码和唯一的密钥
# - 监控异常的API使用情况